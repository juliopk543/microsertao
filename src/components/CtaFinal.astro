---
// monta a URL de um asset em /public respeitando o BASE_URL
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, "/");
---

<section class="py-16 md:py-24 bg-ink-900">
  <div class="container-x">
    <img
      src={asset("Gratuito.png")}
      alt="Comece hoje com a MicroSertão"
      class="mx-auto w-full max-w-sm rounded-3xl reveal"
      loading="lazy"
    />
  </div>
</section>
