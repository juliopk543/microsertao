---
import Icon from "./Icon.astro";
import { cityBenefits, whatsappUrl } from "../data/site";
const wa = whatsappUrl("Olá! Falo em nome de um município filiado à AMA e quero propor o subsídio institucional da MicroSertão.");
// monta a URL de um asset em /public respeitando o BASE_URL
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, "/");
const campaigns = ["Setores em crescimento", "Demanda por mão de obra", "Faixa etária Regional", "Gasto médio regional", "Tipos de negócios ativos"];
---

<section id="prefeituras" class="relative py-20 md:py-28 bg-navy-700 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-grid opacity-30"></div>
  <div class="absolute -top-20 -right-20 -z-10 w-96 h-96 stripes opacity-[0.06] rotate-12"></div>

  <div class="container-x grid lg:grid-cols-2 gap-12 items-center">
    <div class="reveal">
      <a href="https://ama-al.com.br/" target="_blank" rel="noopener" class="block">
        <img src={asset("ama.webp")} alt="AMA - Associação dos Municípios Alagoanos" class="w-full max-w-xs sm:max-w-sm mx-auto mb-6" loading="lazy" />
      </a>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-white/80">
        <Icon name="megaphone" class="w-4 h-4 text-sun-400" /> Meta escalável • AMA
      </span>
      <h2 class="mt-5 font-display font-bold text-white text-3xl sm:text-4xl tracking-tight text-balance">
        Gestão pública digital, direcionada a dados
      </h2>
      <p class="mt-4 text-white/70 text-lg">
        Gerencie a sua cidade dentro do sistema MicroSertão visualizando demandas regionais,
        comportamento dos cidadãos e oportunidades de desenvolvimento através das atividades
        diárias dos MEI e ME.
      </p>

      <div class="mt-7 flex flex-wrap gap-2">
        {campaigns.map((c) => (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/8 border border-white/10 px-3 py-1.5 text-sm text-white/85">
            <span class="w-1.5 h-1.5 rounded-full bg-sun-400"></span>{c}
          </span>
        ))}
      </div>

      <a href={wa} target="_blank" rel="noopener" class="btn mt-8 bg-sun-400 text-navy-700 hover:bg-sun-400/90 font-semibold">
        Propor subsídio institucional
        <Icon name="arrow" class="w-4 h-4" />
      </a>
    </div>

    <div class="reveal">
      <h3 class="font-display font-bold text-white text-2xl sm:text-3xl tracking-tight text-balance">
        Uma rede de dados que cresce a cada município
      </h3>
      <p class="mt-4 text-white/70 text-lg text-pretty">
        Cada novo município associado ao projeto contribui com os dados da sua economia local
        e fortalece a rede AMA como um todo, ampliando os seguintes benefícios:
      </p>

      <ul class="mt-7 grid sm:grid-cols-2 gap-3">
        {cityBenefits.map((b) => (
          <li class="flex items-start gap-3 rounded-2xl bg-white/5 border border-white/10 p-4">
            <span class="grid place-items-center shrink-0 w-7 h-7 rounded-lg bg-sun-400/20 text-sun-400">
              <Icon name={b.icon} class="w-4 h-4" />
            </span>
            <span class="text-sm text-white/85 leading-relaxed">{b.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
