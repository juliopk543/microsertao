---
import Icon from "./Icon.astro";
import { whatsappUrl } from "../data/site";
const waFila = whatsappUrl("Olá! Quero saber mais sobre as ferramentas gratuitas (fila online e cardápio online).");
// monta a URL de um asset em /public respeitando o BASE_URL
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, "/");
---

<section id="preco" class="relative py-20 md:py-28 bg-cream-100 overflow-hidden">
  <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 -z-10 w-[42rem] h-[42rem] rounded-full bg-brand-500/10 blur-[130px]"></div>

  <div class="container-x">
    <div class="pricing-grid">
      <a href={waFila} target="_blank" rel="noopener" class="pricing-cta btn btn-dark reveal">
        <Icon name="whatsapp" class="w-5 h-5" />
        Saiba mais sobre as ferramentas gratuitas
      </a>

      <img
        src={asset("Gratuito.png")}
        alt="Fila online da MicroSertão: é gratuita e poupa tempo dos seus clientes"
        class="pricing-img pricing-img-a mx-auto w-full max-w-md rounded-3xl shadow-xl shadow-black/10 reveal"
        loading="lazy"
      />

      <img
        src={asset("Gratuito2.png")}
        alt="Cardápio online da MicroSertão: é gratuito, atualize quando quiser"
        class="pricing-img pricing-img-b mx-auto w-full max-w-md rounded-3xl shadow-xl shadow-black/10 reveal"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  /* mobile: ordem natural do DOM — botão e as duas imagens, empilhados */
  .pricing-grid { display: grid; gap: 2rem; }
  /* o rótulo é longo e quebra em telas estreitas: balance distribui as linhas
     em vez de deixar uma palavra solta embaixo */
  .pricing-cta {
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
    /* .btn usa line-height: 1, que cola as linhas quando o rótulo quebra */
    line-height: 1.3;
  }

  /* desktop: botão acima, à esquerda; as duas imagens dividem a mesma linha.
     Ambas são 1080×1350 (4:5) e ocupam colunas iguais, então saem do mesmo
     tamanho sem precisar de nenhum ajuste de altura. */
  @media (min-width: 1024px) {
    .pricing-grid {
      max-width: 56rem;
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "cta  ."
        "img  img2";
      column-gap: 4rem;
      row-gap: 1.5rem;
    }
    .pricing-cta {
      grid-area: cta;
      align-self: end;
      justify-self: start;
      margin-inline: 0;
    }
    .pricing-img {
      align-self: start;
      width: 100%;
      max-width: none;
      margin: 0;
    }
    .pricing-img-a { grid-area: img; }
    .pricing-img-b { grid-area: img2; }
  }
</style>
