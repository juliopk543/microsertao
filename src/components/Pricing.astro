---
import Icon from "./Icon.astro";
import { pricing, whatsappUrl } from "../data/site";
const wa = whatsappUrl("Olá! Quero contratar o plano de R$400/ano da MicroSertão.");
const waFila = whatsappUrl("Olá! Quero saber mais sobre a fila online.");
const included = [
  "Orçamento Financeiro",
  "Agendamento online 24h",
  "Loja e estoque",
  "Funcionários e comissões",
  "Suporte e treinamento",
];
// monta a URL de um asset em /public respeitando o BASE_URL
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, "/");
---

<section id="preco" class="relative py-20 md:py-28 bg-cream-100 overflow-hidden">
  <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 -z-10 w-[42rem] h-[42rem] rounded-full bg-brand-500/10 blur-[130px]"></div>

  <div class="container-x">
    <div class="pricing-grid">
      <img
        src={asset("Gratuito.png")}
        alt="Comece hoje com a MicroSertão"
        class="pricing-img mx-auto w-full max-w-md rounded-3xl shadow-xl shadow-black/10 reveal"
        loading="lazy"
      />

      <div class="pricing-heading max-w-2xl mx-auto text-center reveal">
        <span class="eyebrow">Preço justo</span>
        <h2 class="mt-3 font-display font-bold text-ink-950 text-3xl sm:text-4xl tracking-tight text-balance">
          <span class="text-brand-500">R$800,00</span> mais barato.
        </h2>

        <a href={waFila} target="_blank" rel="noopener" class="pricing-cta btn btn-dark mt-6">
          <Icon name="whatsapp" class="w-5 h-5" />
          Saiba mais sobre a fila online
        </a>
      </div>

      <div class="pricing-card-wrap mt-12 grid gap-5 max-w-md mx-auto items-stretch">
        <!-- MicroSertão -->
        <div class="pricing-card relative card p-8 border-brand-500/30 reveal">
          <span class="absolute -top-3 right-6 inline-flex items-center gap-1 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white shadow-lg">
            <Icon name="bolt" class="w-3.5 h-3.5" /> Apenas Coruripe Região
          </span>
          <p class="mt-4 text-5xl font-display font-extrabold text-ink-950 text-[40px]">{pricing.ours.yearly}</p>
          <p class="text-sm text-brand-600 font-medium">{pricing.ours.note}</p>
          <ul class="mt-6 space-y-3">
            {included.map((t) => (
              <li class="flex items-center gap-3 text-sm text-ink-800/80">
                <span class="grid place-items-center w-5 h-5 rounded-full bg-brand-500/15 text-brand-600">
                  <Icon name="check" class="w-3.5 h-3.5" />
                </span>
                {t}
              </li>
            ))}
          </ul>
          <a href={wa} target="_blank" rel="noopener" class="btn btn-primary w-full mt-8">
            <Icon name="whatsapp" class="w-5 h-5" />
            Contratar agora
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* mobile: ordem natural do DOM — imagem, título+botão, card (empilhados) */
  .pricing-grid { display: grid; gap: 2rem; }
  .pricing-cta { margin-inline: auto; }

  /* desktop: imagem + card juntos e inteiros à esquerda; texto + botão à direita, centralizados */
  @media (min-width: 1024px) {
    .pricing-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "img     heading"
        "card    heading";
      align-items: center;
      gap: 3rem;
    }
    .pricing-heading {
      grid-area: heading;
      text-align: left;
      margin-left: 0;
      max-width: none;
    }
    .pricing-img {
      grid-area: img;
      width: 100%;
      max-width: none;
      margin-left: 0;
    }
    .pricing-card-wrap { grid-area: card; margin-top: 0; max-width: none; }
    .pricing-cta { margin-inline: 0; }
  }

  /* card claro, sobre o novo fundo #f5f0e6 */
  .pricing-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.65));
    box-shadow: 0 20px 45px -22px rgba(20, 15, 5, 0.35);
  }
</style>
