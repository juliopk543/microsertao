---
import Icon from "./Icon.astro";
import { pricing, whatsappUrl } from "../data/site";
const wa = whatsappUrl("Olá! Quero contratar o plano de R$400/ano da MicroSertão.");
const waFila = whatsappUrl("Olá! Quero saber mais sobre a fila online.");
const included = [
  "Orçamento Financeiro",
  "Agendamento online 24h",
  "Loja e estoque",
  "Funcionários e comissões",
  "Suporte e treinamento",
];
// monta a URL de um asset em /public respeitando o BASE_URL
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, "/");
---

<section id="preco" class="relative py-20 md:py-28 bg-cream-100 overflow-hidden">
  <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 -z-10 w-[42rem] h-[42rem] rounded-full bg-brand-500/10 blur-[130px]"></div>

  <div class="container-x">
    <div class="pricing-grid">
      <a href={waFila} target="_blank" rel="noopener" class="pricing-cta btn btn-dark reveal">
        <Icon name="whatsapp" class="w-5 h-5" />
        Saiba mais sobre a fila online
      </a>

      <img
        src={asset("Gratuito.png")}
        alt="Comece hoje com a MicroSertão"
        class="pricing-img mx-auto w-full max-w-md rounded-3xl shadow-xl shadow-black/10 reveal"
        loading="lazy"
      />

      <div class="pricing-card-wrap mt-12 grid gap-5 max-w-md mx-auto items-stretch">
        <!-- MicroSertão -->
        <div class="pricing-card relative card p-8 border-brand-500/30 reveal">
          <span class="pricing-badge absolute -top-3 right-6 inline-flex items-center gap-1 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white shadow-lg">
            <Icon name="bolt" class="w-3.5 h-3.5" /> Apenas Coruripe Região
          </span>
          <p class="pricing-price mt-4 text-5xl font-display font-extrabold text-ink-950 text-[40px]">{pricing.ours.yearly}</p>
          <p class="pricing-note text-sm text-brand-600 font-medium">{pricing.ours.note}</p>
          <ul class="pricing-list mt-6 space-y-3">
            {included.map((t) => (
              <li class="pricing-item flex items-center gap-3 text-sm text-ink-800/80">
                <span class="pricing-check grid place-items-center w-5 h-5 rounded-full bg-brand-500/15 text-brand-600">
                  <Icon name="check" class="w-3.5 h-3.5" />
                </span>
                {t}
              </li>
            ))}
          </ul>
          <a href={wa} target="_blank" rel="noopener" class="pricing-card-cta btn btn-primary w-full mt-8">
            <Icon name="whatsapp" class="w-5 h-5" />
            Contratar agora
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* mobile: ordem natural do DOM — botão, imagem, card (empilhados) */
  .pricing-grid { display: grid; gap: 2rem; }
  .pricing-cta { margin-inline: auto; }

  /* card com a mesma proporção da imagem (Gratuito.png é 1080×1350 = 4/5).
     Como o card e a imagem têm a mesma largura (max-w-md), a altura também bate.
     Sendo grid item, o min-height:auto deixa o card crescer se o conteúdo passar. */
  .pricing-card { aspect-ratio: 4 / 5; display: flex; flex-direction: column; }
  .pricing-card-cta { margin-top: auto; }

  /* desktop: botão sobre a imagem (esquerda); imagem e card dividem a mesma
     linha, então o card estica até a altura da imagem. */
  @media (min-width: 1024px) {
    .pricing-grid {
      max-width: 56rem;
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "cta  ."
        "img  card";
      column-gap: 4rem;
      row-gap: 1.5rem;
    }
    .pricing-cta {
      grid-area: cta;
      align-self: end;
      justify-self: start;
      margin-inline: 0;
    }
    .pricing-img {
      grid-area: img;
      align-self: start;
      width: 100%;
      max-width: none;
      margin: 0;
    }
    .pricing-card-wrap {
      grid-area: card;
      align-self: stretch;
      width: 100%;
      max-width: none;
      margin: 0;
    }
    /* no desktop a altura vem do stretch na linha do grid, não da proporção */
    .pricing-card { aspect-ratio: auto; padding: 2.5rem; }
    .pricing-card-cta { font-size: 1.05rem; padding-block: 0.95rem; }

    /* tipografia maior para preencher melhor o card no desktop */
    .pricing-badge { font-size: 0.8125rem; padding: 0.3rem 0.85rem; }
    .pricing-price { font-size: 3.25rem; line-height: 1.05; }
    .pricing-note { font-size: 1.125rem; }
    .pricing-list { margin-top: 2.25rem; }
    .pricing-list > li + li { margin-top: 1.25rem; }
    .pricing-item { font-size: 1.125rem; gap: 0.85rem; }
    .pricing-check { width: 1.625rem; height: 1.625rem; flex: none; }
    .pricing-check svg { width: 1rem; height: 1rem; }
  }

  /* card claro, sobre o novo fundo #f5f0e6 */
  .pricing-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.65));
    box-shadow: 0 20px 45px -22px rgba(20, 15, 5, 0.35);
  }
</style>
