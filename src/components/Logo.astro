---
interface Props { class?: string; light?: boolean }
const { class: className = "", light = false } = Astro.props;
---
<a href="#top" class={`group inline-flex items-center gap-2.5 ${className}`} aria-label="MicroSertão — início">
  <span class="leading-none">
    <span class={`block font-display font-extrabold tracking-tight text-lg ${light ? "text-ink-900" : "text-white"}`}>
      Micro<span class="text-brand-500">Sertão</span>
    </span>
    <span class={`block text-[10px] tracking-[0.22em] uppercase font-medium ${light ? "text-ink-900/40" : "text-white/40"}`}>Software Company</span>
  </span>
</a>
