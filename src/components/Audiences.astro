---
import Icon from "./Icon.astro";
import { audiences, clients } from "../data/site";
const list = [audiences.empreendedor, audiences.prefeitura];
// monta a URL de um asset em /public respeitando o BASE_URL
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, "/");
// O marquee precisa de um grupo mais largo que a tela, senao sobra um vazio
// enorme no loop do desktop. Com so 4 logos, repetimos a lista dentro do grupo.
const REPS = 8;
const clientsLoop = Array.from({ length: REPS }, (_, r) =>
  clients.map((c) => ({ ...c, announce: r === 0 })),
).flat();
---

<section id="publicos" class="relative py-20 md:py-28 bg-ink-950 transition-colors duration-500">
  <div class="container-x">
    <!-- Panels -->
    <div>
      {list.map((a, i) => (
        <div class="aud-panel grid lg:grid-cols-2 gap-10 lg:gap-16 items-center" data-panel={a.key} hidden={i !== 0}>
          <div>
            <img src={asset("Onu.png")} alt="ODS 8.2 - ONU" class="w-full max-w-xs sm:max-w-sm mx-auto mb-6" loading="lazy" />
            <h3 class="font-display font-bold text-2xl sm:text-3xl text-white tracking-tight text-balance" set:html={a.title}></h3>
            {a.description.map((p, i) => (
              <p class={`text-white/60 text-lg text-pretty ${i === 0 ? "mt-4" : "mt-3"}`}>{p}</p>
            ))}
            {a.key !== "empreendedor" && (
              <a href={a.cta.href} class="btn btn-primary mt-7">
                {a.cta.label}
                <Icon name="arrow" class="w-4 h-4" />
              </a>
            )}
          </div>

          <div class="aud-cards grid sm:grid-cols-2 gap-4">
            {/* Bloco 1: cards COM imagem — ganham o efeito de empilhamento (mobile) */}
            <div class="stack-block">
              {a.bullets.filter((b) => b.img).map((b) => (
                <Fragment>
                  <div class="stack-img sm:hidden">
                    <img src={asset(b.img)} alt="" aria-hidden="true" width="1800" height="768" loading="lazy" />
                  </div>
                  <div class="aud-card p-5">
                    <h4 class="font-semibold text-white text-[19px]">{b.title}</h4>
                    <p class="mt-1 text-sm text-white/55 text-[18px]">{b.desc}</p>
                  </div>
                </Fragment>
              ))}
            </div>

            {/* Bloco 2: cards SEM imagem — normais, por último, fora do empilhamento */}
            {a.bullets.some((b) => !b.img) && (
              <div class="flat-block">
                {a.bullets.filter((b) => !b.img).map((b) => (
                  <div class="aud-card p-5">
                    <h4 class="font-semibold text-white text-[19px]">{b.title}</h4>
                    <p class="mt-1 text-sm text-white/55 text-[18px]">{b.desc}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Clientes que já usam o sistema -->
  <div class="mt-20 md:mt-28 clients-section">
    <div class="container-x">
      <p class="text-center text-white/40 text-xs sm:text-sm font-semibold tracking-widest uppercase">
        Já usado por negócios de Coruripe
      </p>
    </div>

    <div class="clients-marquee-wrap mt-8">
      <div class="clients-track">
        <div class="clients-group">
          {clientsLoop.map((c) => (
            /* so a primeira volta da lista e anunciada; as repeticoes sao decoracao */
            <div class="client-logo" aria-hidden={c.announce ? undefined : "true"}>
              <img src={asset(c.img)} alt={c.announce ? c.name : ""} loading="lazy" />
            </div>
          ))}
        </div>
        <div class="clients-group" aria-hidden="true">
          {clientsLoop.map((c) => (
            <div class="client-logo">
              <img src={asset(c.img)} alt="" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("publicos");
  const tabs = document.querySelectorAll<HTMLButtonElement>(".aud-tab");
  const panels = document.querySelectorAll<HTMLElement>(".aud-panel");

  const activate = (key: string) => {
    const isPref = key === "prefeitura";
    // troca de paleta: azul/dourado para Prefeitura, escuro/laranja para Empreendedor
    section?.classList.toggle("theme-navy", isPref);

    tabs.forEach((t) => {
      const on = t.dataset.tab === key;
      t.setAttribute("aria-selected", String(on));
      // a aba ativa usa laranja (empreendedor) — no tema azul o CSS sobrescreve para dourado
      t.classList.toggle("bg-brand-500", on);
      t.classList.toggle("text-white", on);
      t.classList.toggle("text-white/60", !on);
    });
    panels.forEach((p) => {
      p.hidden = p.dataset.panel !== key;
    });
  };

  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));
  // estado inicial
  activate("empreendedor");
</script>

<style is:global>
  /* Tema azul/dourado quando a aba Prefeitura está ativa (igual à seção de municípios) */
  #publicos.theme-navy { background-color: var(--color-navy-700); }
  #publicos.theme-navy .eyebrow { color: var(--color-sun-400); }
  #publicos.theme-navy .aud-tab[aria-selected="true"] {
    background-color: var(--color-sun-400);
    color: #0c2733;
  }
  #publicos.theme-navy .btn-primary {
    background-color: var(--color-sun-400);
    color: #0c2733;
    box-shadow: 0 10px 30px -10px rgba(244, 181, 63, .55);
  }
  #publicos.theme-navy .btn-primary:hover { background-color: #f0ad2e; }
  #publicos.theme-navy .aud-ico {
    background-color: rgba(244, 181, 63, .16);
    color: var(--color-sun-400);
  }
  /* blocos: no desktop fluem no mesmo grid (contents); no mobile viram contextos separados */
  .stack-block, .flat-block { display: contents; }

  /* ===== Scroll stacking intercalado (imagem + card) — somente mobile ===== */
  @media (max-width: 639.98px) {
    /* a área de cards vira coluna; dentro dela, dois blocos empilhados */
    .aud-cards { display: block; }

    /* Bloco 1 (com imagem): coluna única empilhável (imagem, card, imagem, card...) */
    .stack-block { display: block; }
    .stack-block > * + * { margin-top: 1rem; }

    /* imagem (print do app) some no scroll normal, antes do texto chegar —
       sem sticky, então nunca fica presa na tela para o texto passar por cima */
    .stack-block .stack-img {
      position: relative;
      overflow: hidden;
      background: var(--color-ink-950);
    }
    .stack-block .stack-img img {
      display: block;
      width: 100%;
      height: 16rem;
      object-fit: cover;
      object-position: top;
      filter: blur(18px);
      transform: scale(1.06);
      transition: filter .9s ease, transform .9s ease;
    }
    /* aplicado via IntersectionObserver (Layout.astro) quando a imagem entra na tela */
    .stack-block .stack-img.is-visible img {
      filter: blur(0);
      transform: scale(1);
    }
    @media (prefers-reduced-motion: reduce) {
      .stack-block .stack-img img { filter: none; transform: none; transition: none; }
    }
    /* gradiente escuro embaixo: transição suave para o texto que vem a seguir */
    .stack-block .stack-img::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 55%, var(--color-ink-950) 100%);
      pointer-events: none;
    }

    /* Bloco 2 (sem imagem): cards normais, por último, fora do empilhamento */
    .flat-block { display: block; margin-top: 1rem; }
    .flat-block > * + * { margin-top: 1rem; }

    /* ===== Tema Prefeitura (navy): tudo precisa fundir com o azul, não com o preto ===== */
    /* imagem e gradiente de máscara desaparecem no navy (em vez de no ink) */
    #publicos.theme-navy .stack-block .stack-img { background: var(--color-navy-700); }
    #publicos.theme-navy .stack-block .stack-img::after {
      background: linear-gradient(to bottom, transparent 55%, var(--color-navy-700) 100%);
    }
  }

  /* ===== Carrossel de clientes ===== */
  .clients-section { border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 3.5rem; }

  .clients-marquee-wrap {
    overflow: hidden;
    /* fade nas bordas para o scroll infinito parecer contínuo, sem corte abrupto */
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .clients-track {
    display: flex;
    width: max-content;
    /* o trilho ficou bem mais longo com as repeticoes; a duracao acompanha
       para a velocidade continuar suave (~40-60px/s) */
    animation: clients-scroll 70s linear infinite;
  }
  /* pausa a rolagem para a pessoa examinar uma logo parada, em vez de em movimento */
  .clients-marquee-wrap:hover .clients-track,
  .clients-marquee-wrap:focus-within .clients-track {
    animation-play-state: paused;
  }

  /* o padding-right precisa ser igual ao gap: as duas cópias do grupo têm que
     ficar idênticas para o translateX(-50%) emendar sem salto */
  .clients-group { display: flex; align-items: center; gap: 3rem; flex-shrink: 0; padding-right: 3rem; }

  /* sem cartão: os PNGs têm fundo transparente e a logo fica direto sobre o
     fundo da seção (escuro no Empreendedor, azul no Prefeitura) */
  .client-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: 5rem;
  }
  /* limitado só por max-*, nunca por width/height fixos: a proporção original é
     sempre respeitada, então a logo não tem como ser cortada */
  .client-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 10rem;
    max-height: 5rem;
    /* cor neutra por padrão; a cor real da logo só aparece no hover/foco.
       o brightness compensa o cartão branco que saiu: sem ele, as logos
       escuras (caveira, brasão da Garagem) somem no fundo da seção */
    filter: grayscale(1) brightness(1.6) contrast(0.85);
    opacity: 0.75;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }
  .client-logo:hover img,
  .client-logo:focus-visible img {
    filter: none;
    opacity: 1;
  }

  /* no desktop o <html> tem zoom, então em px reais as logos ficam bem menores
     do que o valor em rem sugere — daí o tamanho maior aqui */
  @media (min-width: 1024px) {
    .client-logo { height: 7.5rem; }
    .client-logo img { max-width: 15rem; max-height: 7.5rem; }
  }

  @keyframes clients-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; }
    .clients-group[aria-hidden="true"] { display: none; }
    .clients-group { flex-wrap: wrap; justify-content: center; }
  }
</style>
